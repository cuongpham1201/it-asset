[Unit]
Description=AssetFlow Endpoint Inventory Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/assetflow-agent run --config /etc/assetflow/agent.json
Restart=on-failure
RestartSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/assetflow-agent

[Install]
WantedBy=multi-user.target

