# Release: use an immutable application version.
ASSETFLOW_VERSION=2.1.0
REGISTRY_PREFIX=ghcr.io/duclamtk39

# Public URL. Public production: domain with DNS A/AAAA pointing to this host.
APP_DOMAIN=assets.example.com
APP_URL=https://assets.example.com

POSTGRES_DB=assetflow
POSTGRES_USER=assetflow_app

# Only proxy subnets may be trusted. Adjust for the actual deployment network.
TRUSTED_PROXY_CIDRS=172.16.0.0/12

# SMTP is optional. The password belongs in infra/docker/production/secrets/smtp_password.txt.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=assetflow@example.com
SMTP_FROM=AssetFlow <assetflow@example.com>
