# Public image repository. Replace "yourname" with the lowercase GitHub owner.
ASSETFLOW_REGISTRY=ghcr.io/yourname

# Use a release tag such as 1.2.0. Use edge only for testing.
ASSETFLOW_VERSION=latest

APP_URL=http://localhost:8080
APP_PORT=8080

POSTGRES_DB=assetflow
POSTGRES_USER=assetflow
# Required. Generate a unique password before the first startup.
POSTGRES_PASSWORD=

# Only used with: docker compose --profile auto-update up -d
WATCHTOWER_INTERVAL=3600
