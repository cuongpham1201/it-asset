# Public AssetFlow image repository.
ASSETFLOW_REGISTRY=ghcr.io/duclamtk39

# Stable/UAT release. Use `edge` only on a disposable staging environment.
ASSETFLOW_VERSION=2.1.0

APP_URL=http://localhost:8080
APP_PORT=8080
SESSION_TTL_HOURS=12
TZ=Asia/Ho_Chi_Minh

# Required only for a fresh database. Username is `admin`; the first login must change this password.
# At least 8 characters with upper/lowercase, a number and a special character.
INITIAL_ADMIN_PASSWORD=

# Required only when configuring Microsoft 365 or LDAP synchronization.
# Generate 32 random bytes, for example: openssl rand -base64 32
# Keep this value unchanged and back it up separately; changing it makes saved directory secrets unreadable.
DIRECTORY_ENCRYPTION_KEY=

POSTGRES_DB=assetflow
POSTGRES_USER=assetflow
# Required. Generate a unique password before the first startup.
POSTGRES_PASSWORD=

# Never enable on production. This flag is only read by the explicit `npm run db:seed` command.
ASSETFLOW_DEMO_SEED=false
